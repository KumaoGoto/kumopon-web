{
  "name": "くもぽん",
  "short_name": "くもぽん",
  "description": "びんを まわして 雲を くっつけて、口から ぽんっと だす パズル。ブラウザ版（Android の Chrome は振動つき）",
  "lang": "ja",
  "start_url": "./",
  "scope": "./",
  "display": "fullscreen",
